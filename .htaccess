# ==============================================================================
#  .htaccess — configurações para servidores Apache (hospedagens compartilhadas
#  como Hostinger, HostGator, Locaweb, KingHost etc.)
#  Se usar Nginx, veja o bloco equivalente no README.md.
# ==============================================================================

# --- Página de erro personalizada ---------------------------------------------
ErrorDocument 404 /404.html

# --- Redirecionamentos (SEO: uma única versão canônica do site) ----------------
# Força HTTPS e o prefixo "www". Se preferir SEM www, veja o README.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # /index.html → /  (evita conteúdo duplicado)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# --- Compressão (páginas mais leves = melhor Core Web Vitals) -----------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml application/manifest+json
</IfModule>

# --- Cache no navegador ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
</IfModule>

# --- Cabeçalhos de segurança ----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Tipos de arquivo -------------------------------------------------------------
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddDefaultCharset UTF-8

# Não listar o conteúdo das pastas
Options -Indexes
